<Window x:Class="HttpDld.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HttpDld"
        mc:Ignorable="d"
        Title="HttpDownloader" Height="371" Width="709">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="URL:" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <TextBox x:Name="URLBoxs" HorizontalAlignment="Left" Margin="39,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="602"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,51,0,0" TextWrapping="Wrap" Text="ステータス:" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <TextBlock x:Name="lblStatus" HorizontalAlignment="Left" Margin="82,51,0,0" TextWrapping="Wrap" Text="取得しています・・・" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <ProgressBar x:Name="Progress" HorizontalAlignment="Left" Height="23" Margin="10,101,0,0" VerticalAlignment="Top" Width="631"/>
        <TextBlock x:Name="lblPercent" HorizontalAlignment="Left" Margin="553,51,0,0" TextWrapping="Wrap" Text="取得しています・・・" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <Button x:Name="btnResume" Content="再開" HorizontalAlignment="Left" Margin="510,185,0,0" VerticalAlignment="Top" Height="40" Width="134" FontSize="20" Click="btnResume_Click"/>
        <Button x:Name="btnStart" Content="開始" HorizontalAlignment="Left" Margin="232,185,0,0" VerticalAlignment="Top" Height="40" Width="134" FontSize="20" Click="btnStart_Click"/>
        <Button x:Name="btnPause" Content="中断" HorizontalAlignment="Left" Margin="371,185,0,0" VerticalAlignment="Top" Height="40" Width="134" FontSize="20" Click="btnPause_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,269,0,0" TextWrapping="Wrap" Text="ダウンロードされたサイズ:" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <TextBlock x:Name="lblSize" HorizontalAlignment="Left" Margin="144,269,0,0" TextWrapping="Wrap" Text="--MB" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <TextBlock HorizontalAlignment="Left" Margin="93,298,0,0" TextWrapping="Wrap" Text="速度:" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <TextBlock x:Name="lblSpeed" HorizontalAlignment="Left" Margin="144,298,0,0" TextWrapping="Wrap" Text="--MB/s" VerticalAlignment="Top" Foreground="{DynamicResource Fg}"/>
        <Button x:Name="btnNetCheck" Content="インターネット確認" HorizontalAlignment="Left" Margin="10,185,0,0" VerticalAlignment="Top" Height="40" Width="160" FontSize="20" Click="btnStart_Click"/>

    </Grid>
</Window>
